# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API). Local values match `supabase start`
# and scripts/local-stack/start.sh.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY - never prefix with NEXT_PUBLIC_.
# Used only by the /api/coach/* routes after the bearer token has been verified.
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Public URL of this app (used in the OpenAPI document for ChatGPT Actions).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Coach API
# ---------------------------------------------------------------------------
# Requests per minute per token (default 60).
COACH_API_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Sign-up control (optional). Comma-separated list of emails allowed to create
# an account from the app. Leave empty to allow any email. Also disable
# "Allow new users to sign up" in Supabase Auth once your account exists.
# ---------------------------------------------------------------------------
ALLOWED_SIGNUP_EMAILS=

# Local scripts only (seed, integration tests)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
